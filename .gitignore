# binary and archive types.
*.img
*.iso
*.bmap
*.qcow2
*.exe
*.dll
*.pak
*.gcf
*.vpk
*.big
*.ff
*.iwd
*.zip
*.7z
*.rar

# Python bytecode
__pycache__/
